# Persistence
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=bedrock
SECRET_KEY=replace-with-a-long-random-secret

# Gemini fallback key pool
API_KEY_1=replace-with-gemini-api-key-1
API_KEY_2=replace-with-gemini-api-key-2
API_KEY_3=replace-with-gemini-api-key-3
API_KEY_4=replace-with-gemini-api-key-4
API_KEY_5=replace-with-gemini-api-key-5

# Research and optional provider fallback
TAVILY_API_KEY=replace-with-tavily-api-key
OPENAI_API=replace-with-openai-api-key

# Remote inference (used when REMOTE_GPU=True)
QUERY_URL=https://your-model-host.example/query
REMOTE_GPU=False

# Optional vision parsing
USE_VISION_MODEL=False
VISION_URL=https://your-model-host.example/vision-query
